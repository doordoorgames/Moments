{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/visual-test",
      "destination": "/"
    },
    {
      "source": "/((?!api/|static/|.*\\\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}